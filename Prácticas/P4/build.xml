<project name="Calculator" default="run" basedir=".">
    <!-- Updated properties -->
    <property name="src.dir" value="src/Analizador_Sintáctico_BYACCJ"/>
    <property name="bin.dir" value="bin"/>
    <property name="build.dir" value="bin"/>
    <property name="test.file" value="src/Analizador_Sintáctico_BYACCJ/tst/prueba.txt"/>

    <!-- Create required directories -->
    <target name="init">
        <mkdir dir="${bin.dir}"/>
    </target>

    <!-- Generate Lexer and Parser -->
    <target name="generate" depends="init">
        <!-- Generate Lexer -->
        <condition property="jflex.command" value="jflex.bat" else="jflex">
            <os family="windows"/>
        </condition>
        <exec executable="${jflex.command}">
            <arg value="-d"/>
            <arg value="${src.dir}"/>
            <arg value="${src.dir}/jflex/Lexer.flex"/>
        </exec>
    </target>

    <!-- Clean build files -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete>
            <fileset dir="${src.dir}" includes="Lexer.java"/>
        </delete>
    </target>

    <!-- Compile all Java files -->
    <target name="compile" depends="clean, generate">
        <mkdir dir="${build.dir}"/>
        
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <pathelement location="${src.dir}"/>
            </classpath>
            <include name="**/*.java"/>
        </javac>
    </target>

    <!-- Run the calculator -->
    <target name="run" depends="compile">
        <java classname="src.Analizador_Sintáctico_BYACCJ.Main" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.dir}"/>
                <pathelement location="."/>
            </classpath>
            <arg value="${test.file}"/>
        </java>
    </target>

</project>