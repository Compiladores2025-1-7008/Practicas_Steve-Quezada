<project name="Calculator" default="run" basedir=".">
    <!-- Updated properties -->
    <property name="src.dir" value="src/Calculadora_BYACCJ_JFlex"/>
    <property name="bin.dir" value="bin"/>
    <property name="build.dir" value="bin"/>

    <!-- Create required directories -->
    <target name="init">
        <mkdir dir="${bin.dir}"/>
    </target>

    <!-- Generate Lexer and Parser -->
    <target name="generate" depends="init">
        <!-- Generate Lexer -->
        <condition property="jflex.command" value="jflex.bat" else="jflex">
            <os family="windows"/>
        </condition>
        <exec executable="${jflex.command}">
            <arg value="-d"/>
            <arg value="${src.dir}"/>
            <arg value="${src.dir}/jflex/Lexer.flex"/>
        </exec>

        <!-- Generate Parser -->
        <exec executable="byaccj">
            <arg value="-J"/>
            <arg value="${src.dir}/byacc/Parser.y"/>
        </exec>
        <move todir="${src.dir}">
            <fileset dir="." includes="Parser*.java"/>
        </move>
    </target>

    <!-- Clean build files -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete>
            <fileset dir="${src.dir}" includes="Lexer.java,Parser*.java"/>
        </delete>
    </target>

    <!-- Compile all Java files -->
    <target name="compile" depends="clean, generate">
        <mkdir dir="${build.dir}"/>
        
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <pathelement location="${src.dir}"/>
            </classpath>
            <include name="**/*.java"/>
        </javac>
    </target>

    <!-- Run the calculator -->
    <target name="run" depends="compile">
        <java classname="Main" fork="false" failonerror="true">
            <classpath>
                <pathelement path="${build.dir}"/>
                <pathelement path="."/>
            </classpath>
        </java>
    </target>

</project>